# Frontend only. Use the Supabase publishable/anon key, never the service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Configure these as Supabase Edge Function secrets, NOT VITE_ variables:
# PAYSTACK_SECRET_KEY=sk_test_...
# SITE_URL=https://your-deployed-site.example
# Paystack webhook URL:
# https://YOUR_PROJECT.supabase.co/functions/v1/paystack-webhook
